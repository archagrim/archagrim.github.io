{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier 3D",
  "version": "1.0.0",
  "identifier": "io.github.archagrim.atelier3d",
  "build": {
    "frontendDist": "../../3d"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atelier 3D",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "archagrim",
    "shortDescription": "Visionneuse 3MF et STL en taille réelle",
    "longDescription": "Atelier 3D affiche vos fichiers 3MF et STL en taille réelle, avec une bibliothèque reliée à vos dossiers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "3mf"
        ],
        "name": "Atelier3D.3mf",
        "description": "Modèle 3D (3MF)",
        "mimeType": "model/3mf",
        "role": "Viewer"
      },
      {
        "ext": [
          "stl"
        ],
        "name": "Atelier3D.stl",
        "description": "Modèle 3D (STL)",
        "mimeType": "model/stl",
        "role": "Viewer"
      },
      {
        "ext": [
          "obj"
        ],
        "name": "Atelier3D.obj",
        "description": "Modèle 3D (OBJ)",
        "mimeType": "model/obj",
        "role": "Viewer"
      },
      {
        "ext": [
          "ply"
        ],
        "name": "Atelier3D.ply",
        "description": "Modèle 3D (PLY)",
        "mimeType": "application/octet-stream",
        "role": "Viewer"
      },
      {
        "ext": [
          "glb"
        ],
        "name": "Atelier3D.glb",
        "description": "Modèle 3D (GLB)",
        "mimeType": "model/gltf-binary",
        "role": "Viewer"
      },
      {
        "ext": [
          "gltf"
        ],
        "name": "Atelier3D.gltf",
        "description": "Modèle 3D (glTF)",
        "mimeType": "model/gltf+json",
        "role": "Viewer"
      },
      {
        "ext": [
          "off"
        ],
        "name": "Atelier3D.off",
        "description": "Modèle 3D (OFF)",
        "mimeType": "text/plain",
        "role": "Viewer"
      },
      {
        "ext": [
          "fbx"
        ],
        "name": "Atelier3D.fbx",
        "description": "Modèle 3D (FBX)",
        "mimeType": "application/octet-stream",
        "role": "Viewer"
      },
      {
        "ext": [
          "dae"
        ],
        "name": "Atelier3D.dae",
        "description": "Modèle 3D (Collada)",
        "mimeType": "model/vnd.collada+xml",
        "role": "Viewer"
      },
      {
        "ext": [
          "3ds"
        ],
        "name": "Atelier3D.3ds",
        "description": "Modèle 3D (3DS)",
        "mimeType": "application/octet-stream",
        "role": "Viewer"
      },
      {
        "ext": [
          "amf"
        ],
        "name": "Atelier3D.amf",
        "description": "Modèle 3D (AMF)",
        "mimeType": "application/x-amf",
        "role": "Viewer"
      },
      {
        "ext": [
          "wrl"
        ],
        "name": "Atelier3D.wrl",
        "description": "Modèle 3D (VRML)",
        "mimeType": "model/vrml",
        "role": "Viewer"
      },
      {
        "ext": [
          "x3d"
        ],
        "name": "Atelier3D.x3d",
        "description": "Modèle 3D (X3D)",
        "mimeType": "model/x3d+xml",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}